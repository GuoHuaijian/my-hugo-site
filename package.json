{
  "name": "cloud-edge-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run generate && node node_modules/vite/bin/vite.js --host 0.0.0.0",
    "generate": "node scripts/generate-index.js",
"generate:dev": "node scripts/generate-index.js --include-drafts",
    "build": "npm run generate && node scripts/optimize-images.js && node scripts/generate-sitemap.js && node scripts/generate-rss.js && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "highlight.js": "^11.11.1",
    "lucide-vue-next": "^0.511.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.15.0",
    "vite": "^6.3.5",
    "vue": "^3.5.14",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
